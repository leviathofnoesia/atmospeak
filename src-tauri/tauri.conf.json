{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atmospeak",
  "version": "1.0.4",
  "identifier": "app.atmospeak.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$LOCALDATA/Atmospeak/recordings/**"]
      },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://github.com https://api.github.com https://www.novpax.org https://updates.novpax.org https://api.polar.sh https://polar.sh; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/asr/atmospeak-asr-cpu.exe",
      "resources/asr/transcribe.dll",
      "resources/asr/ggml.dll",
      "resources/asr/ggml-base.dll",
      "resources/asr/ggml-cpu-x64.dll",
      "resources/asr/ggml-cpu-sse42.dll",
      "resources/asr/ggml-cpu-sandybridge.dll",
      "resources/asr/ggml-cpu-haswell.dll",
      "resources/asr/ggml-cpu-skylakex.dll",
      "resources/asr/ggml-cpu-cannonlake.dll",
      "resources/asr/ggml-cpu-cascadelake.dll",
      "resources/asr/ggml-cpu-icelake.dll",
      "resources/asr/ggml-cpu-alderlake.dll",
      "resources/asr/MSVCP140.dll",
      "resources/asr/MSVCP140_1.dll",
      "resources/asr/VCRUNTIME140.dll",
      "resources/asr/VCRUNTIME140_1.dll",
      "resources/models/parakeet-unified-en-0.6b-Q8_0.gguf",
      "resources/transcription-licenses/NVIDIA-Open-Model-License.pdf",
      "resources/transcription-licenses/NOTICE.txt",
      "resources/transcription-licenses/transcribe-cpp-MIT.txt",
      "resources/transcription-licenses/ggml-MIT.txt",
      "resources/llama-runtime/*",
      "resources/ACKNOWLEDGEMENTS.md"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3RjM2RjFDRjE5NTM3RTgKUldUb041WHhIRy96eHl6N3VOcDN1OXRUV20zTmJrRmoyM1k2TWZSajEvSGhPd0NrdTJnNjU4Nk8K",
      "endpoints": [
        "https://www.novpax.org/downloads/atmospeak/free/latest.json"
      ]
    }
  }
}
