{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atmospeak",
  "version": "1.0.3",
  "identifier": "app.atmospeak.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' asset: http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost https://github.com https://api.github.com https://downloads.novpax.org https://updates.novpax.org https://api.polar.sh https://polar.sh; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/whisper-cli"
    ],
    "resources": [
      "resources/whisper-runtime/whisper-cli.exe",
      "resources/whisper-runtime/whisper-server.exe",
      "resources/whisper-runtime/whisper.dll",
      "resources/whisper-runtime/ggml.dll",
      "resources/whisper-runtime/ggml-base.dll",
      "resources/whisper-runtime/ggml-cpu.dll",
      "resources/models/ggml-base.en.bin",
      "resources/asr/*",
      "resources/llama-runtime/*",
      "resources/ACKNOWLEDGEMENTS.md"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3RjM2RjFDRjE5NTM3RTgKUldUb041WHhIRy96eHl6N3VOcDN1OXRUV20zTmJrRmoyM1k2TWZSajEvSGhPd0NrdTJnNjU4Nk8K",
      "endpoints": [
        "https://downloads.novpax.org/atmospeak/free/latest.json"
      ]
    }
  }
}
