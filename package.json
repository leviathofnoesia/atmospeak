{
  "name": "atmospeak",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "preview": "vite preview",
    "tauri": "tauri",
    "release:build": "powershell -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "release:portable": "powershell -ExecutionPolicy Bypass -File scripts/package-release.ps1 -SkipTauriBuild",
    "release:test-install": "powershell -ExecutionPolicy Bypass -File scripts/test-install-uninstall.ps1",
    "validation:production": "powershell -ExecutionPolicy Bypass -File scripts/production-validation.ps1",
    "site:dev": "vite --config website/vite.config.ts",
    "site:build": "vite build --config website/vite.config.ts",
    "site:preview": "vite preview --config website/vite.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.7"
  }
}
