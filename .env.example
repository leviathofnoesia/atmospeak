ATMOSPEAK_RELEASE_REPO=leviathofnoesia/atmospeak

# Tauri build accepts the raw private key content in TAURI_SIGNING_PRIVATE_KEY.
# The local release script also accepts TAURI_SIGNING_PRIVATE_KEY_PATH and will
# load the key from disk without committing it.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PATH=C:\Users\billy\.tauri\atmospeak\updater.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Windows code-signing certificate material is intentionally not configured for
# this prototype. Unsigned installers may trigger SmartScreen until a trusted
# certificate or Azure Trusted Signing profile is added.

# Date this build is released, as YYYY-MM-DD. Licence update windows compare
# against this instead of the system clock. The release script sets it
# automatically; build.rs falls back to today for developer builds.
ATMOSPEAK_RELEASE_DATE=

# Ed25519 private key used to mint licence keys, as 64 hex characters. Vendor
# side only — this must never be committed and never ship in a build. Generate
# one with `cargo run --bin mint -- generate-keypair` from src-license/, keep it
# in a password manager, and export it only for the length of a minting session.
# The application embeds only the matching *public* key.
ATMOSPEAK_LICENSE_SIGNING_KEY=
