ATMOSPEAK_RELEASE_REPO=leviathofnoesia/atmospeak

# Tauri build accepts the raw private key content in TAURI_SIGNING_PRIVATE_KEY.
# The local release script also accepts TAURI_SIGNING_PRIVATE_KEY_PATH and will
# load the key from disk without committing it.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PATH=C:\Users\billy\.tauri\atmospeak\updater.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Windows code-signing certificate material is intentionally not configured for
# this prototype. Unsigned installers may trigger SmartScreen until a trusted
# certificate or Azure Trusted Signing profile is added.
