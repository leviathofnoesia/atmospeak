# Free release artifact base (public CDN). Packaging writes latest.json URLs here.
ATMOSPEAK_FREE_CDN_BASE=https://downloads.novpax.org/atmospeak/free

# Optional GitHub Releases mirror repo (not the advertised download URL).
ATMOSPEAK_RELEASE_REPO=leviathofnoesia/atmospeak

# Tauri updater signing (minisign). Required for latest.json + .sig artifacts.
# The local release script also accepts TAURI_SIGNING_PRIVATE_KEY_PATH and will
# load the key from disk without committing it.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PATH=C:\Users\billy\.tauri\atmospeak\updater.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Windows Authenticode / Azure Trusted Signing — required before selling Pro.
# Prefer Nov Pax publisher identity so SmartScreen reputation matches novpax.org.
# WINDOWS_CERTIFICATE_THUMBPRINT=
# AZURE_TRUSTED_SIGNING_*=

# --- Pro builds only (cargo feature `pro`) ---
# Polar organization + product used for online licence activate/validate.
ATMOSPEAK_POLAR_ORGANIZATION_ID=
ATMOSPEAK_POLAR_LICENSE_BENEFIT_ID=
# Public Polar checkout link for the $69 Atmospeak Pro product (website Buy CTA).
ATMOSPEAK_POLAR_CHECKOUT_URL=https://buy.polar.sh/polar_cl_REPLACE
# Offline grace after a successful online validate (days). Pro stays usable offline
# within this window; after it expires the next online check is required.
ATMOSPEAK_LICENSE_GRACE_DAYS=14
# Gated Pro update API (Cloudflare Worker / services/pro-updates).
ATMOSPEAK_PRO_UPDATE_BASE=https://updates.novpax.org/atmospeak/pro
# Private R2/S3 credentials for Pro CI upload + Worker pre-signed URLs (never ship in the app).
# ATMOSPEAK_PRO_R2_ACCOUNT_ID=
# ATMOSPEAK_PRO_R2_ACCESS_KEY_ID=
# ATMOSPEAK_PRO_R2_SECRET_ACCESS_KEY=
# ATMOSPEAK_PRO_R2_BUCKET=atmospeak-pro
# POLAR_ACCESS_TOKEN=   # server-side only (Worker / CI), never in the desktop app
